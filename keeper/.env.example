NETWORK=testnet

PACKAGE_ID=


MARKET_ID=
VAULT_ID=
TREASURY_ID=


KEEPER_PRIVATE_KEY=


PRICE_SOURCE=mock
PYTH_FEED_ID=
PYTH_API_KEY=

POLL_INTERVAL_MS=30000


FUNDING_CRANK_INTERVAL_MS=600000


# suiprivkey1... for the ed25519 key that signs price reports (npm run generate-price-signer)
PRICE_SIGNER_PRIVATE_KEY=
# port the signed-price HTTP endpoint listens on (default 8787)
PRICE_SIGNER_PORT=
# bind address for that endpoint (default 127.0.0.1 - localhost only)
PRICE_SIGNER_HOST=
# Access-Control-Allow-Origin for it (default *, e.g. http://localhost:5173)
PRICE_SIGNER_ALLOWED_ORIGIN=
# Binance ticker symbol to poll (default BTCUSDT)
PRICE_SIGNER_SYMBOL=
# how often to re-read the Binance price, ms (default 5000)
PRICE_SIGNER_POLL_INTERVAL_MS=
# ms subtracted from the observation time as clock-skew margin (default 2000)
PRICE_SIGNER_TIMESTAMP_SKEW_MS=
# set false to keep the keeper running without serving signed prices (default: true when the key is set)
PRICE_SERVER_ENABLED=
